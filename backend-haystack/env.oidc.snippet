# Append these lines to your backend .env (e.g. /opt/ominis-backend/.env or backend-haystack/.env).
# OIDC for LibreChat (chat.ominis.org) — same user base as ia.ominis.org.
# OIDC_LIBRECHAT_CLIENT_SECRET must match OPENID_CLIENT_SECRET in librechat-chat/.env. Rotate both together.
OIDC_LIBRECHAT_CLIENT_ID=librechat
OIDC_LIBRECHAT_CLIENT_SECRET=118efd575b36856bccca6da82f9b457f210d4be4b7b8fa0ed6541a2ffffb5eb7
OIDC_LIBRECHAT_REDIRECT_URIS=https://chat.ominis.org/oauth/openid/callback
