# ===========================================
# Ominis Health - Haystack Backend Configuration
# ===========================================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://ominis_admin:your-secure-password@127.0.0.1:5432/ominis_haystack
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://ominis_admin:your-secure-password@127.0.0.1:5432/ominis_haystack

# JWT Authentication
JWT_SECRET=your-jwt-secret-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Ollama - LLM inference servers
# Each model can run on a separate Ollama server (different GPU instances).
# The backend routes to the correct server based on the model selected.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# Ominis Med = BioMistral 7B (medical). Same server if OLLAMA_CLINIC_URL is empty.
OLLAMA_CLINIC_URL=
OLLAMA_CLINIC_MODEL=cniongolo/biomistral
OLLAMA_TIMEOUT=90
# EC2 instance IDs for dashboard start/stop (often same g4dn for both)
# OLLAMA_INSTANCE_ID=       # g4dn from config/ollama_gpu_server.txt
# OLLAMA_CLINIC_INSTANCE_ID= # same g4dn or leave empty to use OLLAMA_INSTANCE_ID

# Optional: third chat model "Ominis 2.0 Open" (e.g. Qwen 3, Llama 3.3). Leave empty to hide.
# OLLAMA_OPEN_MODEL=qwen3:14b
# OLLAMA_OPEN_URL=   # empty = use OLLAMA_URL (same server)

# Optional: "Ominis 2.0 Med" = Med42-v2 (clinical LLM, M42 Health). Leave empty to hide.
# On the Ollama server: ollama pull med42 (or the image name from https://huggingface.co/m42-health)
# OLLAMA_MED_MODEL=med42
# OLLAMA_MED_URL=   # empty = use OLLAMA_URL (same server)
# OLLAMA_MED_INSTANCE_ID=   # EC2 for dashboard start/stop; empty = use OLLAMA_INSTANCE_ID

# GPT (gpt-oss, código abierto) vía vLLM. Si POWER_API_URL está definida, "GPT" aparece en el chat y en el dashboard.
# See docs/GPT_OSS_POWER.md. 20B ~16GB VRAM; 120B needs ≥60GB.
# POWER_API_URL=   # e.g. http://<host>:8000 (vLLM adds /v1 in code)
# POWER_MODEL=openai/gpt-oss-20b
# POWER_API_KEY=EMPTY
# POWER_TIMEOUT=120
# POWER_INSTANCE_ID=   # EC2 instance ID for dashboard start/stop (e.g. g5.2xlarge)

# OpenScholar - Modo Investigación (ominis-2.0-research, 8K context)
# OPENSCHOLAR_MODEL must match the model name served by the research GPU (vLLM --served-model-name).
# If you get "model 'X' not found (404)", set this to the name actually deployed on OPENSCHOLAR_API_URL.
OPENSCHOLAR_API_URL=http://44.217.135.115:8000
OPENSCHOLAR_MODEL=openscholar
OPENSCHOLAR_TEMPERATURE=0.2
OPENSCHOLAR_API_KEY=dummy
OPENSCHOLAR_TIMEOUT=120
# EC2 instance ID for start/stop from dashboard (run 14-deploy-openscholar.sh)
OPENSCHOLAR_INSTANCE_ID=

# OpenScholar 128K - long-context research (ominis-2.0-research-128k). Deploy with 15-deploy-openscholar-128k.sh
OPENSCHOLAR_128K_API_URL=
OPENSCHOLAR_128K_INSTANCE_ID=
OPENSCHOLAR_128K_AUTO_STOP_MINUTES=60
OPENSCHOLAR_128K_TIMEOUT=300

# AWS - for research instance start/stop (region where GPU instances live)
AWS_REGION_GPU=us-east-1
# Optional: if backend runs outside AWS or in another account, set credentials
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# Optional: external embedding service (e.g. bge on RTX 4090). When set, EMBEDDING_DIMENSION must match service output (e.g. 1024).
# EMBEDDING_SERVICE_URL=http://host:8080

# Optional: Med42 (A100) for clinical translation step in research. OpenAI-compatible.
# MED42_API_URL=http://host:8000/v1
# MED42_MODEL=med42
# MED42_TIMEOUT=60

# Optional: Qwen2.5-VL for vision (figures, OCR). When set, used for image analysis instead of Ollama.
# QWEN_VL_API_URL=http://host:8000/v1
# QWEN_VL_MODEL=qwen2.5-vl
# QWEN_VL_TIMEOUT=60

# S3 - Existing embeddings/chunks storage
AWS_REGION=mx-central-1
EMBEDDINGS_BUCKET=ominis-health-embeddings-mx
VECTOR_PREFIX=vectors

# CORS (include all frontend origins: dashboard la.ominis.org, ai.ominis.org, etc.)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://ominis.org,https://ia.ominis.org,https://la.ominis.org,https://ai.ominis.org,https://chat.ominis.org

# Google OAuth — "Continuar con Google" on login. Set in Google Cloud: Authorized redirect URI = https://api.ominis.org/v1/api/connect/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BACKEND_PUBLIC_URL=https://api.ominis.org   # optional; use when behind proxy so OAuth redirect_uri is correct

# Scraper: set to false if the server's CA bundle can't verify some HTTPS targets (e.g. riisp.insp.mx)
# SCRAPE_SSL_VERIFY=false

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Analytical layer (SAV → Parquet): if set, .sav uploads are also saved as Parquet for run_analytical_query
# Example: /opt/ominis-backend/data/analytical
# ANALYTICAL_DATA_DIR=

# Open Scholar (Semantic Scholar) — source option for academic paper search (default off in chat)
# Get a key at https://www.semanticscholar.org/product/api for higher rate limits.
# SEMANTIC_SCHOLAR_API_KEY=

# LiveAvatar (HeyGen) — for /live page. Get key at app.liveavatar.com
# HEYGEN_LIVE_AVATAR_API_KEY=
# HEYGEN_LIVE_AVATAR_AVATAR_ID=bf00036b-558a-44b5-b2ff-1e3cec0f4ceb   # Marianne Sitting
# HEYGEN_LIVE_AVATAR_VOICE_ID=1bd001e7e50f421d891986aad0228f13       # Alessandra - IA
# HEYGEN_LIVE_AVATAR_SANDBOX=false   # false for Marianne; sandbox only allows Wayne

# Pipecat Cloud — when set, /live uses Ominis Med (ominis-2.0-clinic) instead of HeyGen LLM
# PIPECAT_AGENT_NAME=ominis-live-avatar
# PIPECAT_API_TOKEN=
# LIVE_JOIN_BASE_URL=https://ia.ominis.org

# All.Can México (Strapi) — /v1/allcan-directory/search + RAG tool; requires read token from api.allcan.mx
# ALLCAN_STRAPI_URL=https://api.allcan.mx
# ALLCAN_STRAPI_API_TOKEN=

# Doctor / All.Can semantic search (default model: paraphrase-multilingual-MiniLM-L12-v2). If EMBEDDING_SERVICE_URL is set, directory search uses that API instead (dimensions must match).
# DIRECTORY_SEMANTIC_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# OIDC (LibreChat) — same user base as ia.ominis.org. Chat uses OpenID Connect; login/register only on ia.ominis.org.
# Generate a secret: openssl rand -hex 32
# OIDC_LIBRECHAT_CLIENT_ID=librechat
# OIDC_LIBRECHAT_CLIENT_SECRET=<shared-secret-with-librechat-env>
# OIDC_LIBRECHAT_REDIRECT_URIS=https://chat.ominis.org/oauth/openid/callback
