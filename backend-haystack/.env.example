# ===========================================
# Ominis Health - Haystack Backend Configuration
# ===========================================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://ominis_admin:your-secure-password@127.0.0.1:5432/ominis_haystack
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://ominis_admin:your-secure-password@127.0.0.1:5432/ominis_haystack

# JWT Authentication
JWT_SECRET=your-jwt-secret-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Ollama - LLM inference servers
# Each model can run on a separate Ollama server (different GPU instances).
# The backend routes to the correct server based on the model selected.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=ominis-2.0

# Falcon-40B runs on a separate GPU server (g5.2xlarge / A10G 24GB VRAM)
# Set this to the Falcon GPU server's Elastic IP after running 16-deploy-falcon-gpu.sh
FALCON_OLLAMA_URL=http://localhost:11434

# Available models:
#   ominis-2.0           -> OLLAMA_URL         (g4dn.xlarge / T4 16GB)
#   falcon-40b-instruct  -> FALCON_OLLAMA_URL  (g5.2xlarge / A10G 24GB)

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# S3 - Existing embeddings/chunks storage
AWS_REGION=mx-central-1
EMBEDDINGS_BUCKET=ominis-health-embeddings-mx
VECTOR_PREFIX=vectors

# CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://ominis.org

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
