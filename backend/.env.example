# Strapi Configuration
HOST=0.0.0.0
PORT=1337
APP_KEYS=your-app-key-1,your-app-key-2,your-app-key-3,your-app-key-4

# Admin JWT Secret - CHANGE IN PRODUCTION
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-me

# API Token Salt - CHANGE IN PRODUCTION
API_TOKEN_SALT=your-api-token-salt-change-me

# Transfer Token Salt - CHANGE IN PRODUCTION
TRANSFER_TOKEN_SALT=your-transfer-token-salt-change-me

# JWT Secret for Users-Permissions plugin
JWT_SECRET=your-jwt-secret-change-me

# Database Configuration
# For SQLite (development)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# For PostgreSQL (production) - Uncomment and configure
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=ominis_admin
# DATABASE_USERNAME=ominis_admin
# DATABASE_PASSWORD=your-secure-password
# DATABASE_SSL=false

# Initial SuperAdmin credentials (for seeding only)
SUPERADMIN_EMAIL=admin@ominis.org
SUPERADMIN_PASSWORD=ChangeThisPassword123!
SUPERADMIN_FIRSTNAME=Super
SUPERADMIN_LASTNAME=Admin

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Ominis API Configuration
OMINIS_API_URL=http://localhost:8000

# Public URL (set to your domain in production)
PUBLIC_URL=https://admin.ominis.org
