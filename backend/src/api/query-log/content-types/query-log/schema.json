{
  "kind": "collectionType",
  "collectionName": "query_logs",
  "info": {
    "singularName": "query-log",
    "pluralName": "query-logs",
    "displayName": "Query Log",
    "description": "Log of API queries for analytics"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "queryHash": {
      "type": "string",
      "required": true
    },
    "endpoint": {
      "type": "enumeration",
      "enum": [
        "query",
        "query-gpu"
      ],
      "required": true
    },
    "responseTimeMs": {
      "type": "integer"
    },
    "tokensGenerated": {
      "type": "integer"
    },
    "sourcesUsed": {
      "type": "integer"
    },
    "success": {
      "type": "boolean",
      "default": true
    },
    "errorType": {
      "type": "string"
    },
    "apiKey": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::api-key.api-key"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "userAgent": {
      "type": "string"
    },
    "ipHash": {
      "type": "string"
    },
    "metadata": {
      "type": "json"
    }
  }
}
