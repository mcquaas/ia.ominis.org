{
  "kind": "singleType",
  "collectionName": "system_stats",
  "info": {
    "singularName": "system-stat",
    "pluralName": "system-stats",
    "displayName": "System Stats",
    "description": "RAG and model system statistics"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "totalSources": {
      "type": "integer",
      "default": 0
    },
    "indexedSources": {
      "type": "integer",
      "default": 0
    },
    "totalChunks": {
      "type": "integer",
      "default": 0
    },
    "embeddingsSize": {
      "type": "string"
    },
    "faissIndexSize": {
      "type": "string"
    },
    "lastIndexUpdate": {
      "type": "datetime"
    },
    "modelVersion": {
      "type": "string",
      "default": "ominis-2.0"
    },
    "modelStatus": {
      "type": "enumeration",
      "enum": [
        "online",
        "offline",
        "degraded"
      ],
      "default": "offline"
    },
    "cpuServerStatus": {
      "type": "enumeration",
      "enum": [
        "online",
        "offline",
        "degraded"
      ],
      "default": "offline"
    },
    "gpuServerStatus": {
      "type": "enumeration",
      "enum": [
        "online",
        "offline",
        "degraded"
      ],
      "default": "offline"
    },
    "avgResponseTimeCpu": {
      "type": "decimal"
    },
    "avgResponseTimeGpu": {
      "type": "decimal"
    },
    "totalQueries24h": {
      "type": "integer",
      "default": 0
    },
    "totalQueriesWeek": {
      "type": "integer",
      "default": 0
    },
    "totalQueriesMonth": {
      "type": "integer",
      "default": 0
    },
    "errorRate24h": {
      "type": "decimal",
      "default": 0
    },
    "lastHealthCheck": {
      "type": "datetime"
    },
    "systemNotes": {
      "type": "text"
    }
  }
}
