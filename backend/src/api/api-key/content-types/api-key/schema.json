{
  "kind": "collectionType",
  "collectionName": "api_keys",
  "info": {
    "singularName": "api-key",
    "pluralName": "api-keys",
    "displayName": "API Key",
    "description": "API keys for Ominis API access"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "text"
    },
    "keyHash": {
      "type": "string",
      "required": true,
      "private": true
    },
    "keyPrefix": {
      "type": "string",
      "required": true,
      "maxLength": 12
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "inactive",
        "revoked",
        "expired"
      ],
      "default": "active",
      "required": true
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "permissions": {
      "type": "json",
      "default": {
        "query": true,
        "queryGpu": false,
        "sources": false
      }
    },
    "rateLimit": {
      "type": "integer",
      "default": 100,
      "min": 1,
      "max": 10000
    },
    "rateLimitWindow": {
      "type": "enumeration",
      "enum": [
        "minute",
        "hour",
        "day"
      ],
      "default": "hour"
    },
    "requestsCount": {
      "type": "biginteger",
      "default": 0
    },
    "lastUsedAt": {
      "type": "datetime"
    },
    "expiresAt": {
      "type": "datetime"
    },
    "ipWhitelist": {
      "type": "json"
    },
    "metadata": {
      "type": "json"
    }
  }
}
