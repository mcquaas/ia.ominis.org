# Ollama on Vast.ai: Qwen3 (chat) + Qwen2.5-VL (vision)
# Copy to config/ollama_qwen_vast.txt after running 24f-vast-ai-create-ollama-qwen-vl.sh
# Get IP:PORT from Vast instance → IP & Port Info → mapping for 11434

OLLAMA_QWEN_VAST_URL=http://REPLACE_IP:REPLACE_PORT
# Chat model when no image (Ominis 2.0)
OLLAMA_MODEL=qwen3:14b
# Vision model when user sends image
VISION_MODEL=qwen2.5vl:7b
