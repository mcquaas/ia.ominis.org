      "backend_env_key": "vast_serverless_med42_endpoint",
      "models": "OpenAI-compatible — MED42_MODEL"
    },
    {
      "endpoint_name": "ominis-qwen-vl",
      "template_id": null,
      "template_hash": null,
      "backend_env_key": "vast_serverless_qwen_vl_endpoint",
      "models": "vLLM multimodal — QWEN_VL_MODEL e.g. Qwen/Qwen2.5-VL-7B-Instruct"
