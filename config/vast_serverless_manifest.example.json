{
  "_comment": "Copy to config/vast_serverless_manifest.json. Fill template_id OR template_hash per workload (from: python3 infrastructure/vast_serverless_search_templates.py --name-contains vLLM). Then run: python3 infrastructure/vast_serverless_provision_manifest.py --manifest config/vast_serverless_manifest.json",
  "defaults": {
    "min_load": 0,
    "target_util": 0.9,
    "cold_mult": 2.0,
    "cold_workers": 0,
    "max_workers": 12,
    "gpu_ram": 24,
    "search_params": "verified=true rentable=true"
  },
