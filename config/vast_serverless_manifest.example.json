    },
    {
      "endpoint_name": "ominis-vllm-power",
      "template_id": null,
      "template_hash": null,
      "backend_env_key": "vast_serverless_power_endpoint",
      "models": "vLLM OpenAI — POWER_MODEL e.g. openai/gpt-oss-20b"
    },
    {
      "endpoint_name": "ominis-openscholar-8k",
      "template_id": null,
      "template_hash": null,
      "backend_env_key": "vast_serverless_openscholar_endpoint",
      "models": "vLLM — OPENSCHOLAR_MODEL (e.g. openscholar)"
    },
    {
      "endpoint_name": "ominis-openscholar-128k",
